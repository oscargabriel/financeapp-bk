# Copiar a bruno/.env (no versionado) y llenar con valores reales.
#
# El token de la mayor parte de la coleccion sale de auth/login, que lo guarda en la variable
# accessToken de la corrida. Desde FA-43 las carpetas auth/ y system/ no van con ese token sino
# con la credencial compartida del Basic, que es la que abre el registro, el login y el status.

# Se definen cuando exista el despliegue publico.
PROD_HOST=

# Usuario contra el que corren los requests de reportes.
# En local es el que crea docs/database/test-data.sql.
PROD_USER_ID=

# Contrasena del usuario que crea docs/database/test-data.sql, para los requests de login.
# El valor esta documentado en el comentario de ese archivo, junto al hash que le corresponde.
TEST_USER_PASSWORD=

# Credencial compartida del Basic. Tiene que coincidir con BASIC_USERNAME / BASIC_PASSWORD de la
# aplicacion: son las mismas variables, leidas por el otro lado.
BASIC_USERNAME=
BASIC_PASSWORD=
